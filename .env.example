# =====================
# SERVER
# =====================
PORT=3000
NODE_ENV=development
API_VERSION=v1

# =====================
# DATABASE (MySQL)
# =====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webxemphim_db
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql

# =====================
# JWT
# =====================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# =====================
# REDIS (for seat locking & BullMQ)
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Seat hold durations
SEAT_HOLD_TTL_SECONDS=300       # 5 phút khi chọn ghế
SEAT_CHECKOUT_TTL_SECONDS=900   # 15 phút khi chờ thanh toán

# =====================
# CLOUDINARY (upload poster, backdrop)
# =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =====================
# VNPAY
# =====================
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn

# =====================
# EMAIL (Nodemailer)
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CineStar <no-reply@cinestar.vn>"

# =====================
# CORS
# =====================
FRONTEND_URL=http://localhost:3001

# =====================
# RATE LIMIT
# =====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
