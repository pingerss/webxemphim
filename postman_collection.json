      "name": "🎟️ Booking (🔒 Cần đăng nhập)",
      "item": [
        {
          "name": "⭐ Giữ ghế (Hold Seats)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/bookings/hold",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showtime_id\": 1,\n  \"seat_ids\": [1, 2],\n  \"combo_items\": [\n    { \"combo_id\": 1, \"quantity\": 2 }\n  ]\n}"
            },
            "description": "Giữ ghế 5 phút. Trả về booking_id và hold_expires_at"
          }
        },
        {
          "name": "⭐ Tạo link thanh toán (Checkout)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/bookings/checkout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1,\n  \"voucher_code\": \"\"\n}"
            },
            "description": "Gia hạn ghế lên 15 phút, tạo URL VNPay để thanh toán"
          }
        },
        {
          "name": "Lịch sử đặt vé của tôi",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/my?page=1&limit=10",
