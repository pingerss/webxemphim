              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "now_showing", "disabled": true },
                { "key": "search", "value": "Avengers", "disabled": true },
                { "key": "genre_id", "value": "1", "disabled": true }
