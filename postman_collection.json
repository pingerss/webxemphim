    {
      "name": "💳 Payment",
      "item": [
        {
          "name": "VNPay Return (redirect sau thanh toán)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/vnpay/return?vnp_ResponseCode=00&vnp_TxnRef=CS-ABC123&vnp_SecureHash=xxx",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "vnpay", "return"],
              "query": [
                { "key": "vnp_ResponseCode", "value": "00" },
                { "key": "vnp_TxnRef", "value": "CS-ABC123" },
                { "key": "vnp_SecureHash", "value": "xxx" }
              ]
            },
            "description": "VNPay redirect user về URL này sau khi thanh toán"
          }
        },
        {
          "name": "VNPay IPN (server-to-server callback)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments/vnpay/ipn",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vnp_TxnRef\": \"CS-ABC123\",\n  \"vnp_ResponseCode\": \"00\",\n  \"vnp_Amount\": \"15000000\",\n  \"vnp_TransactionNo\": \"14233456\",\n  \"vnp_SecureHash\": \"xxx\"\n}"
            },
            "description": "VNPay gọi ngầm về đây để xác nhận giao dịch"
          }
        }
      ]
