        },
        {
          "name": "Chi tiết đơn đặt vé",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/bookings/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Hủy đơn đặt vé",
          "request": {
